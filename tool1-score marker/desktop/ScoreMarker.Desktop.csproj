<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScoreMarker.Desktop</RootNamespace>
    <AssemblyName>ScoreMarker.Desktop</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <AssemblyTitle>智能批分助手</AssemblyTitle>
    <Product>智能批分助手</Product>
    <Company>Score Marker</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="setup\**\*.cs" />
    <Page Remove="setup\**\*.xaml" />
    <ApplicationDefinition Remove="setup\**\App.xaml" />
    <None Remove="setup\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\backend\release\score-marker.exe" Link="Resources\score-marker.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\frontend\**\*">
      <Link>Resources\frontend\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
