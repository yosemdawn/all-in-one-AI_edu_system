NODE_ENV=production
PORT=3000
NODE_IMAGE=node:22-alpine
MONGO_IMAGE=mongo:7
REDIS_IMAGE=redis:7-alpine
# Generate independent hex secrets (at least 32 bytes each). Required by Compose.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
# Compose supplies authenticated MONGODB_URI and REDIS_URL to the backend.
JWT_SECRET=
CORS_ORIGINS=https://your-frontend.example.com
TRUST_PROXY=uniquelocal

DOUBAO_API_KEY=replace-with-your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
AI_REVIEW_REQUIRED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10
SWAGGER_ENABLED=false
ENABLE_DEMO_SEED=false

AI_REQUEST_TIMEOUT_MS=60000
