{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "checkJs": false,
          "module": "CommonJS",
          "target": "ES2023"
        },
        "diagnostics": false
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(htmlparser2|domhandler|domutils|domelementtype|dom-serializer|entities|launder)/)"
  ]
}
